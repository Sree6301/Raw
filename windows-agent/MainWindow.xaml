<Window x:Class="SmartXeroxHub.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMART XEROX HUB — Professional Xerox, Photo Printing &amp; Flatbed Scanning Station"
        Height="780" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header & Brand Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Categorized Tab Control -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status & Log Output Bar -->
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR WITH LOGO AND HARDWARE PILL -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Software Logo & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="Transparent" Width="52" Height="52" Margin="0,0,14,0">
                        <Image Source="Assets/logo.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SMART XEROX HUB" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
                            <Border Background="#0284C7" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="ECOSYSTEM PRO" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="HP Smart Tank 589 Management Console • Manual Duplex • Flatbed Scanner" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live Connection & RAW_Inputs Directory Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PillRealtime" Background="#064E3B" CornerRadius="16" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtRealtime" Text="● LIVE SYNC ACTIVE" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border x:Name="PillPrinter" Background="#0C4A6E" CornerRadius="16" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtPrinterStatus" Text="● HP 589 ONLINE (USB001)" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Button Content="📁 RAW_Inputs" Click="BtnOpenRawInputs_Click" Background="#334155" Foreground="White" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Margin="0,0,6,0"/>
                    <Button Content="Hardware Setup Wizard" Click="BtnSetupWizard_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TAB CONTROL: PROPERLY CATEGORIZED AND ALIGNED -->
        <TabControl Grid.Row="1" Background="#F8FAFC" BorderThickness="0" Margin="12,8,12,6">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" CornerRadius="8,8,0,0" Background="#E2E8F0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#CBD5E1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: LIVE ORDERS & ADMIN PORTAL (LIVE QUEUE) -->
            <TabItem Header="📋 Live Orders &amp; Admin Queue">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter, Sort & Control Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Live Orders Queue" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="10,0,14,0">
                                    <TextBlock x:Name="TxtOrderCount" Text="0 Orders in Queue" Foreground="#1D4ED8" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- Sorting and Searching Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort by:" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ComboSortBy" Width="170" Padding="6,4" SelectionChanged="ComboSortBy_SelectionChanged" Margin="0,0,12,0">
                                    <ComboBoxItem Content="⏱️ Time (Newest First)" IsSelected="True"/>
                                    <ComboBoxItem Content="⏱️ Time (Oldest First)"/>
                                    <ComboBoxItem Content="📊 Status (Pending First)"/>
                                    <ComboBoxItem Content="💰 Price (High to Low)"/>
                                    <ComboBoxItem Content="💰 Price (Low to High)"/>
                                </ComboBox>

                                <TextBlock Text="Filter:" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtSearchFilter" Width="180" Padding="6,4" TextChanged="TxtSearchFilter_TextChanged" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="🔄 Refresh Now" Click="BtnRefreshOrders_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="12,6" Margin="0,0,6,0"/>
                                <Button Content="🖨️ Test Print A4" Click="BtnTestPrintA4_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="12,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Live Orders DataGrid -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                        <DataGrid x:Name="GridOrders" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0" Background="White" RowHeight="48"
                                  FocusVisualStyle="{x:Null}" SelectionUnit="FullRow">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#F1F5F9"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F8FAFC"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="120" FontWeight="Bold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceType}" Width="80" IsReadOnly="True"/>
                                
                                <!-- Clickable File/Request Column -->
                                <DataGridTemplateColumn Header="File / Request (Click to Open)" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding OriginalFileName}" Click="BtnOpenFile_Click"
                                                    Background="Transparent" Foreground="#0284C7" FontWeight="Bold"
                                                    Cursor="Hand" BorderThickness="0" HorizontalAlignment="Left"
                                                    ToolTip="Click to open this document/scan on your system"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Interactive Pages Column (Editable for Scans only) -->
                                <DataGridTemplateColumn Header="Pages" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBox Text="{Binding RequestedPagesCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="46" Height="26" Padding="2,2" TextAlignment="Center" FontWeight="Bold"
                                                         LostFocus="TxtRowPages_LostFocus" KeyDown="TxtRow_KeyDown"
                                                         ToolTip="Modify scan requested pages">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditPages}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Text="{Binding TotalPages}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#334155">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditPages}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Interactive Copies Column (Editable for Documents & Photos) -->
                                <DataGridTemplateColumn Header="Copies" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBox Text="{Binding Copies, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="46" Height="26" Padding="2,2" TextAlignment="Center" FontWeight="Bold"
                                                         LostFocus="TxtRowCopies_LostFocus" KeyDown="TxtRow_KeyDown"
                                                         ToolTip="Click to modify copies">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditCopies}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Text="—" HorizontalAlignment="Center" Foreground="#94A3B8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditCopies}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Interactive Color Column (B/W or Color) -->
                                <DataGridTemplateColumn Header="Color" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding ColorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="ComboRowColor_SelectionChanged"
                                                      Height="26" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                                <ComboBoxItem Content="Black &amp; White" Tag="BW"/>
                                                <ComboBoxItem Content="Color" Tag="COLOR"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Interactive Sides Column (Single or Duplex - Documents Only) -->
                                <DataGridTemplateColumn Header="Sides" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <ComboBox SelectedValue="{Binding Sides, Mode=TwoWay}"
                                                          SelectedValuePath="Tag"
                                                          SelectionChanged="ComboRowSides_SelectionChanged"
                                                          Height="26" FontSize="11" FontWeight="SemiBold">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditSides}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                    <ComboBoxItem Content="Single Side" Tag="SINGLE"/>
                                                    <ComboBoxItem Content="Manual Duplex" Tag="MANUAL_DUPLEX"/>
                                                </ComboBox>
                                                <TextBlock Text="N/A" HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditSides}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Interactive Status Column (Completed, Pending, Failed) -->
                                <DataGridTemplateColumn Header="Status" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Status, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="ComboRowStatus_SelectionChanged"
                                                      Height="26" VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                                                <ComboBoxItem Content="⏳ Pending" Tag="PENDING"/>
                                                <ComboBoxItem Content="⏳ Submitted" Tag="SUBMITTED"/>
                                                <ComboBoxItem Content="✅ Completed" Tag="COMPLETED"/>
                                                <ComboBoxItem Content="❌ Failed" Tag="FAILED"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Interactive Price (₹) Column -->
                                <DataGridTemplateColumn Header="Price (₹)" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="₹" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                <TextBox Text="{Binding CalculatedPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                         Width="56" Height="26" Padding="2,2" TextAlignment="Right" FontWeight="Bold" Foreground="#059669"
                                                         LostFocus="TxtRowPrice_LostFocus" KeyDown="TxtRow_KeyDown"
                                                         ToolTip="Click to edit price"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <!-- Operator Physical Action Column -->
                                <DataGridTemplateColumn Header="Operator Physical Action" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                <Border Background="#10B981" CornerRadius="4" Padding="6,3" Margin="0,0,6,0"
                                                        Visibility="{Binding HasScannedPages, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ScanProgressBadge}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0"
                                                        Visibility="{Binding HasHardwareInstruction, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding HardwareInstruction}" Foreground="#92400E" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                
                                                <!-- Active Action Button (Approve & Print) - Hidden when Completed -->
                                                <Button Content="{Binding ActionButtonText}" Click="BtnRowAction_Click"
                                                        Visibility="{Binding CanApproveAndPrint, Converter={StaticResource BoolToVis}}"
                                                        Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,4" Margin="0,0,6,0" BorderThickness="0"/>

                                                <!-- Completed Badge when order is complete -->
                                                <Border Background="#E2E8F0" CornerRadius="4" Padding="8,4" Margin="0,0,6,0"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="✅ Completed" Foreground="#475569" FontWeight="Bold" FontSize="11"/>
                                                </Border>

                                                <!-- Settings Button: at the right side of action -->
                                                <Button Content="⚙️ Settings" Click="BtnRowSettings_Click"
                                                        Background="#475569" Foreground="White" Padding="8,4" BorderThickness="0"
                                                        ToolTip="Configure Print Layout &amp; Settings"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- IN-WINDOW MANUAL DUPLEX STEP-BY-STEP CONTROLLER -->
                    <Border Grid.Row="2" x:Name="DuplexWizardCard" Visibility="Collapsed" Background="#0F172A" CornerRadius="12" Padding="16" Margin="0,10,0,0" BorderBrush="#0284C7" BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Wizard Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#0284C7" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock Text="HP 589 DUPLEX WIZARD" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <TextBlock x:Name="TxtDuplexWizardHeader" Text="Active Order: 1-221126D • Total: 6 Pages" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="✖ Close Wizard" Click="BtnCloseDuplexWizard_Click" Background="#334155" Foreground="#94A3B8" FontWeight="SemiBold" Padding="10,4" HorizontalAlignment="Right" BorderThickness="0"/>
                            </Grid>

                            <!-- 4 Step Sequential Flow -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Step 1 -->
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STEP 1: Print Odd Side" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock x:Name="TxtDuplexStep1Detail" Text="Pages 1, 3, 5 ascending" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>
                                        <Button x:Name="BtnDuplexStep1Print" Content="▶ 1. Print Odd Pages" Click="BtnDuplexStep1_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="8,6" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2 -->
                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#D97706" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STEP 2: Reverse Paper" FontWeight="Bold" Foreground="#FBBF24" FontSize="12"/>
                                        <TextBlock Text="Flip printed stack face-down in rear tray" FontSize="11" Foreground="#FDE68A" Margin="0,2,0,8"/>
                                        <Button x:Name="BtnDuplexStep2Confirm" Content="🔄 2. Page Reversed" Click="BtnDuplexStep2_Click" Background="#D97706" Foreground="White" FontWeight="Bold" Padding="8,6" BorderThickness="0" IsEnabled="False"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3 -->
                                <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STEP 3: Print Other Side" FontWeight="Bold" Foreground="#34D399" FontSize="12"/>
                                        <TextBlock x:Name="TxtDuplexStep3Detail" Text="Reverse even: 6, 4, 2" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>
                                        <Button x:Name="BtnDuplexStep3Print" Content="▶ 3. Print Other Side" Click="BtnDuplexStep3_Click" Background="#059669" Foreground="White" FontWeight="Bold" Padding="8,6" BorderThickness="0" IsEnabled="False"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 4 -->
                                <Border Grid.Column="3" Background="#1E293B" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STEP 4: Complete Job" FontWeight="Bold" Foreground="#A7F3D0" FontSize="12"/>
                                        <TextBlock Text="Verify print and finish" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>
                                        <Button x:Name="BtnDuplexStep4Done" Content="✅ 4. Job Complete" Click="BtnDuplexStep4_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="8,6" BorderThickness="0" IsEnabled="False"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: IN-SOFTWARE CUSTOMER / DESK PRINT SERVICES -->
            <TabItem Header="📤 Desk Printing Services">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Document Xerox Desk -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📄 Document Xerox Desk" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Print local PDF files directly with duplex &amp; N-up control." Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>

                                <!-- File Browse -->
                                <TextBlock Text="1. Select Document (PDF)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDeskDocPath" IsReadOnly="True" Padding="6" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseDeskDoc_Click" Margin="6,0,0,0" Padding="10,6" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                                </Grid>

                                <!-- Color Mode -->
                                <TextBlock Text="2. Color Mode" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioDocBw" Content="B&amp;W" IsChecked="True" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RadioDocColor" Content="Color (CMYK)" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Sides (Single vs Duplex) -->
                                <TextBlock Text="3. Printing Sides" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioDocSingle" Content="Single-Sided" IsChecked="True" FontWeight="SemiBold" Margin="0,0,12,0" Checked="RadioDocSides_Changed"/>
                                    <RadioButton x:Name="RadioDocDuplex" Content="Manual Duplex" FontWeight="SemiBold" Checked="RadioDocSides_Changed"/>
                                </StackPanel>

                                <!-- Manual Duplex In-Desk Step Guide (Visible when Duplex selected) -->
                                <Border x:Name="PanelDeskDuplexSteps" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Duplex Instructions" FontWeight="Bold" Foreground="#15803D" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock Text="Step 1: Prints odd pages (1, 3, 5...) ascending.&#x0a;Step 2: Take printed stack, flip 180° without reordering, re-insert into rear tray, and print reverse even pages." Foreground="#166534" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Copies -->
                                <TextBlock Text="4. Number of Copies" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDeskDocCopies" Text="1" Width="80" HorizontalAlignment="Left" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,14"/>

                                <!-- Action Buttons -->
                                <Button Content="⚙️ Settings &amp; Live Preview" Click="BtnDeskDocSettings_Click" Background="#475569" Foreground="White" FontWeight="Bold" Padding="10,8" BorderThickness="0" Margin="0,0,0,8"/>
                                <Button Content="🖨️ Print to HP Smart Tank 589" Click="BtnPrintDeskDoc_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,10" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 1: Photo Printing Desk -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="🖼️ Photo Printing Desk" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="High-gloss borderless or bordered photo prints." Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>

                                <!-- Photo File Browse -->
                                <TextBlock Text="1. Select Image (JPG / PNG)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDeskPhotoPath" IsReadOnly="True" Padding="6" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseDeskPhoto_Click" Margin="6,0,0,0" Padding="10,6" Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                                </Grid>

                                <!-- Paper Size -->
                                <TextBlock Text="2. Photo Paper Size" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioPhoto4x6" Content="4 × 6 inch" IsChecked="True" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RadioPhotoA4" Content="A4 Full Sheet" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Border / Borderless -->
                                <TextBlock Text="3. Photo Framing" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioDeskPhotoBorderless" Content="Borderless" IsChecked="True" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RadioDeskPhotoWithBorder" Content="With Border" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Color Mode -->
                                <TextBlock Text="4. Color Mode" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RadioPhotoColor" Content="Full Color" IsChecked="True" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RadioPhotoBw" Content="Black &amp; White" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Copies -->
                                <TextBlock Text="5. Number of Copies" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDeskPhotoCopies" Text="1" Width="80" HorizontalAlignment="Left" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,14"/>

                                <!-- Action Buttons -->
                                <Button Content="⚙️ Settings &amp; Live Preview" Click="BtnDeskPhotoSettings_Click" Background="#475569" Foreground="White" FontWeight="Bold" Padding="10,8" BorderThickness="0" Margin="0,0,0,8"/>
                                <Button Content="🖼️ Print Clean Photo on HP 589" Click="BtnPrintDeskPhoto_Click" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,10" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 2: Passport Photos (8-Up on 4x6 HP Glossy) -->
                        <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🛂 Passport Photos (8-Up)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Pre-configured 1800×1200 px landscape on 4×6 HP Glossy Paper." Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>

                                <!-- Passport Image Browse -->
                                <TextBlock Text="1. Select Portrait Photo (JPG / PNG)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDeskPassportPath" IsReadOnly="True" Padding="6" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseDeskPassport_Click" Margin="6,0,0,0" Padding="10,6" Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                                </Grid>

                                <!-- Calibrated 8-Up Live Preview -->
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="140" Margin="0,0,0,12" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ImgDeskPassportPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDeskPassportEmpty" Text="Select a photo to preview 8-Up sheet" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,14">
                                    <TextBlock Text="🔒 Calibrated Standard: 397×513 px per photo, 36 px col/row gaps, 36 px left margin, 12 px top margin. Zero bottom or side cropping." Foreground="#1D4ED8" FontSize="10" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Action Buttons -->
                                <Button Content="⚙️ Passport Settings" Click="BtnDeskPassportSettings_Click" Background="#475569" Foreground="White" FontWeight="Bold" Padding="10,8" BorderThickness="0" Margin="0,0,0,8"/>
                                <Button Content="🖨️ Print 8-Up on 4×6 HP Paper" Click="BtnPrintDeskPassport_Click" Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,10" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: HP FLATBED SCANNER CONSOLE -->
            <TabItem Header="🔍 HP Flatbed Scanner Console">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scanner Controls & Batch Options -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,12,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="HP Smart Tank 589 Flatbed Scanner" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Physical glass capture. Zero synthetic overlays or watermarks." Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>

                                <!-- Scan Progress & Live Count Card -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtScanProgress" Text="● Scanner Ready" FontWeight="Bold" Foreground="#059669" FontSize="12"/>
                                        <TextBlock x:Name="TxtSessionPageCount" Text="Current Batch: 0 page(s) scanned" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Resolution Selection (150, 300, 600, 1200 DPI) -->
                                <TextBlock Text="1. Optical Resolution (DPI)" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" x:Name="RadioScan150" Content="150 DPI (Draft)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <RadioButton Grid.Column="1" x:Name="RadioScan300" Content="300 DPI (Standard)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" x:Name="RadioScan600" Content="600 DPI (Fine)" FontWeight="SemiBold"/>
                                    <RadioButton Grid.Column="1" x:Name="RadioScan1200" Content="1200 DPI (Studio)" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Color Mode -->
                                <TextBlock Text="2. Color Mode" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="RadioScanColor" Content="Full Color (24-bit)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="RadioScanGrayscale" Content="Grayscale (8-bit)" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Big Trigger Scan Buttons -->
                                <Button x:Name="BtnAcquireRealScan" Content="🔍 Scan Page on Glass (Add to Batch)" Click="BtnAcquireRealScan_Click"
                                        Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="13" Padding="12,10" BorderThickness="0" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="➕ Next Page" Click="BtnContinueScan_Click" Background="#475569" Foreground="White" FontWeight="SemiBold" Padding="8,6" BorderThickness="0" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="🆕 New Batch" Click="BtnNewScanBatch_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" Padding="8,6" Margin="4,0,0,0"/>
                                </Grid>

                                <!-- Save Batch Options -->
                                <TextBlock Text="3. Save &amp; Export Batch Options" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RadioMergeSinglePdf" Content="Single Combined PDF" GroupName="PdfFormatGroup" IsChecked="True" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <RadioButton x:Name="RadioIndividualPdfs" Content="Individual PDFs" GroupName="PdfFormatGroup" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Button Content="💾 Save as PDF Document(s)" Click="BtnSavePdf_Click" Background="#059669" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🖼️ Save as PNG" Click="BtnSavePng_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" Padding="8,6" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="🖼️ Save as JPEG" Click="BtnSaveJpeg_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" Padding="8,6" Margin="4,0,0,0"/>
                                </Grid>

                                <Button Content="📁 Open RAW_Inputs/Scans Folder" Click="BtnOpenScansFolder_Click" Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" Padding="10,6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Live Scanned Gallery & Large Preview -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Scanned Pages Batch Gallery" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtScanFileSaved" Text="No scan acquired yet" FontSize="11" Foreground="#059669" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Gallery Thumbnail Strip -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                <ListView x:Name="ListScannedPages" BorderThickness="0" Background="Transparent" SelectionChanged="ListScannedPages_SelectionChanged">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Padding="6" Margin="0,0,8,0" Width="130">
                                                <StackPanel>
                                                    <Image Source="{Binding Thumbnail}" Height="60" Stretch="Uniform" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="▲" Tag="{Binding}" Click="BtnPageMoveUp_Click" Padding="4,1" FontSize="9" Margin="0,0,2,0" Background="#F1F5F9" BorderBrush="#CBD5E1"/>
                                                        <Button Content="▼" Tag="{Binding}" Click="BtnPageMoveDown_Click" Padding="4,1" FontSize="9" Margin="0,0,2,0" Background="#F1F5F9" BorderBrush="#CBD5E1"/>
                                                        <Button Content="↷" Tag="{Binding}" Click="BtnPageRotate_Click" Padding="4,1" FontSize="9" Margin="0,0,2,0" Background="#F1F5F9" BorderBrush="#CBD5E1" ToolTip="Rotate 90°"/>
                                                        <Button Content="🗑️" Tag="{Binding}" Click="BtnPageDelete_Click" Padding="4,1" FontSize="9" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" ToolTip="Delete page"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>

                            <!-- Large Active Preview -->
                            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="ImgScanPreview" Stretch="Uniform" MaxHeight="450"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: PRINTERS & SPOOLER HARDWARE -->
            <TabItem Header="🖨️ Hardware &amp; Spooler">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="HP Smart Tank 589 Hardware Queues" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="USB (USB001) is active default for maximum reliability. Wi-Fi (WSD) is available." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Switch to USB (USB001)" Click="BtnSwitchUsb_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0"/>
                                <Button Content="Switch to Wi-Fi (WSD)" Click="BtnSwitchWifi_Click" Background="#334155" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                        <ListView x:Name="ListPrinters" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <TextBlock Text="  [CURRENT ACTIVE DEFAULT]" Foreground="#0284C7" FontWeight="Bold" FontSize="11"
                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PortName}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding DriverName}" FontSize="10" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusDescription}" Foreground="#047857" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: SETTINGS, PRICING & FOLDERS -->
            <TabItem Header="⚙️ Settings, Pricing &amp; Folders">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Pricing & Shop Rates -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="💰 Shop Rates &amp; Pricing Architecture" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Dynamic rates synchronized across Customer Web, Admin Portal, and Agent." Foreground="#64748B" FontSize="11" Margin="0,0,0,14"/>

                                <TextBlock Text="A4 Black &amp; White Single Side (₹/page)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPriceA4BwSingle" Text="2.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                                <TextBlock Text="A4 Black &amp; White Double Side Duplex (₹/sheet)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPriceA4BwDuplex" Text="3.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                                <TextBlock Text="A4 Color Single Side (₹/page)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPriceA4ColorSingle" Text="10.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                                <TextBlock Text="A4 Color Double Side Duplex (₹/sheet)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPriceA4ColorDuplex" Text="18.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                                <TextBlock Text="Glossy Photo 4×6 inch (₹/photo)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPricePhoto4x6" Text="20.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                                <TextBlock Text="Glossy Photo A4 Sheet (₹/sheet)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPricePhotoA4" Text="40.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                                <TextBlock Text="Flatbed Scan Rate (₹/page)" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtPriceScanPage" Text="10.00" Padding="6" BorderBrush="#CBD5E1" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💾 Save &amp; Sync Pricing" Click="BtnSavePricing_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12" Padding="14,8" BorderThickness="0" Margin="0,0,8,0"/>
                                    <Button Content="🔄 Reload Rates" Click="BtnReloadPricing_Click" Background="#F1F5F9" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" BorderBrush="#CBD5E1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: RAW_Inputs Folders & System Diagnostics -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📁 RAW_Inputs Storage Folders" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="All customer PDFs, uploaded photos, and physical scans are archived here." Foreground="#64748B" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <Button Content="📁 Open RAW_Inputs Root Folder" Click="BtnOpenRawInputs_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,8" Margin="0,0,0,8" BorderThickness="0"/>
                                <Button Content="📂 Open RAW_Inputs/User_Uploads" Click="BtnOpenUserUploadsFolder_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" Padding="12,8" Margin="0,0,0,8"/>
                                <Button Content="📂 Open RAW_Inputs/Scans" Click="BtnOpenScansFolder_Click" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" Padding="12,8" Margin="0,0,0,16"/>

                                <TextBlock Text="System Diagnostics &amp; Status" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBlock Text="Target Host: Windows 11 Pro 64-bit&#x0a;Backend API: http://localhost:3001/api&#x0a;Realtime WebSocket: Active" FontFamily="Consolas" FontSize="11" Foreground="#334155" Margin="0,0,0,14"/>
                                <Button Content="📄 Print Duplex Calibration Test Sheet" Click="BtnPrintCalibration_Click" Background="#334155" Foreground="White" FontWeight="Bold" Padding="12,8" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BOTTOM STATUS & STRUCTURED EVENT LOG -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Hardware Event &amp; Communication Stream" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtLogCount" Text="Logs active" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>
                <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>

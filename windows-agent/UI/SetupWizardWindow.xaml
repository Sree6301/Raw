<Window x:Class="SmartXeroxHub.Agent.UI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMART XEROX HUB • Hardware Discovery &amp; Calibration Wizard"
        Height="540" Width="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0284C7" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtStepCounter" Text="STEP 1 OF 15 • HARDWARE DISCOVERY WIZARD" Foreground="#BAE6FD" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="TxtStepTitle" Text="Welcome to HP Smart Tank 589 Setup" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Dynamic Step Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
            <StackPanel x:Name="PanelStepContent" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStepDescription" Text="Description of step..." FontSize="13" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Border x:Name="BoxStepDetails" Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtStepDetails" Text="Hardware information..." FontSize="12" Foreground="#0F172A" FontFamily="Consolas"/>
                </Border>
                <Button x:Name="BtnStepAction" Content="Execute Hardware Test" Click="BtnStepAction_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="14,10" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnPrevious" Content="Back" Click="BtnPrevious_Click" Padding="18,8" Background="#F1F5F9" BorderBrush="#CBD5E1" IsEnabled="False"/>
            <Button Grid.Column="2" x:Name="BtnNext" Content="Next Step →" Click="BtnNext_Click" Padding="24,8" Background="#0284C7" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>

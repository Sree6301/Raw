<Window x:Class="SmartXeroxHub.Agent.UI.ScannedImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanned Page Studio — Edit, Rotate &amp; Enhance"
        Height="640" Width="960"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0F172A">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="16,10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTitle" Text="🔍 SCANNED PAGE EDITOR &amp; ENHANCEMENT" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Rotate, convert color mode, and clean up physical flatbed captures" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#7C3AED" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageBadge" Text="PAGE 1" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Tools on Left, Canvas on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tools Panel -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="14" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Rotation Tools -->
                        <TextBlock Text="Orientation &amp; Rotation" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button Content="↷ 90° CW" Click="BtnRotateCW_Click" Background="#334155" Foreground="White" Padding="8,6" Margin="0,0,4,4" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="↶ 90° CCW" Click="BtnRotateCCW_Click" Background="#334155" Foreground="White" Padding="8,6" Margin="4,0,0,4" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="🔃 180° Flip" Click="BtnRotate180_Click" Background="#334155" Foreground="White" Padding="8,6" Margin="0,4,4,0" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="↔ Flip H" Click="BtnFlipH_Click" Background="#334155" Foreground="White" Padding="8,6" Margin="4,4,0,0" BorderThickness="0" Cursor="Hand"/>
                        </UniformGrid>

                        <Separator Background="#334155" Margin="0,0,0,14"/>

                        <!-- Color & Contrast Adjustments -->
                        <TextBlock Text="Color &amp; Mode" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,14">
                            <RadioButton x:Name="RadioColorOriginal" Content="Full Color (Original)" IsChecked="True" Foreground="#CBD5E1" Checked="OnColorFilterChanged" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RadioGrayscale" Content="Grayscale (Clean Black &amp; White)" Foreground="#CBD5E1" Checked="OnColorFilterChanged" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RadioHighContrast" Content="High Contrast Document" Foreground="#CBD5E1" Checked="OnColorFilterChanged" Margin="0,0,0,6"/>
                        </StackPanel>

                        <Separator Background="#334155" Margin="0,0,0,14"/>

                        <!-- Zoom & Pan Controls -->
                        <TextBlock Text="Zoom / Fit" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"/>
                        <Slider x:Name="SliderZoom" Minimum="0.5" Maximum="3.0" Value="1.0" ValueChanged="SliderZoom_ValueChanged" Margin="0,0,0,10"/>
                        <Button Content="🔄 Reset View" Click="BtnResetView_Click" Background="#334155" Foreground="White" Padding="10,6" BorderThickness="0" Cursor="Hand" Margin="0,0,0,14"/>

                        <!-- File Details -->
                        <Border Background="#0F172A" CornerRadius="4" Padding="10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📄 File Info:" FontWeight="Bold" Foreground="#A78BFA" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtFileInfo" Text="Loading..." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Image Viewport -->
            <Border Grid.Column="1" Background="#020617" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Border Background="White" CornerRadius="2" BorderBrush="#475569" BorderThickness="1">
                            <Image x:Name="ImgScannedPreview" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="TransformScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Image.LayoutTransform>
                            </Image>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Background="#334155" Foreground="White" FontWeight="SemiBold" Padding="18,8" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="💾 Save &amp; Apply Changes" Click="BtnSave_Click" Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="22,8" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
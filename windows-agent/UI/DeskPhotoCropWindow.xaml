<Window x:Class="SmartXeroxHub.Agent.UI.DeskPhotoCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desk Photo Studio — Crop, Adjust &amp; Layout"
        Height="640" Width="920"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0F172A">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="16,10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTitle" Text="📷 PASSPORT PHOTO CROP &amp; ALIGNMENT STUDIO" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Drag image to align face within guideline frame • Adjust zoom and rotation" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0284C7" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModeBadge" Text="PASSPORT 8-UP" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Left Controls & Right Interactive Canvas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls Panel -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="14" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Photo Specific Controls (Visible only in Photo mode) -->
                        <StackPanel x:Name="PanelPhotoOptions" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Paper Size" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboPaperSize" SelectionChanged="OnPhotoSettingChanged" Padding="6,4" Margin="0,0,0,10">
                                <ComboBoxItem Content="4×6 Index Photo (102 × 152 mm)" Tag="PHOTO_4X6" IsSelected="True"/>
                                <ComboBoxItem Content="A4 Full Page Photo (210 × 297 mm)" Tag="PHOTO_A4"/>
                            </ComboBox>

                            <TextBlock Text="Orientation" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RadioPortrait" Content="Portrait" IsChecked="True" Foreground="#CBD5E1" Checked="OnPhotoSettingChanged" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RadioLandscape" Content="Landscape" Foreground="#CBD5E1" Checked="OnPhotoSettingChanged"/>
                            </StackPanel>

                            <TextBlock Text="Paper Margin / Framing" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RadioBorderless" Content="Borderless (Full Bleed)" IsChecked="True" Foreground="#CBD5E1" Checked="OnPhotoSettingChanged" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RadioBorder" Content="With Margin (White Border)" Foreground="#CBD5E1" Checked="OnPhotoSettingChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Zoom Slider -->
                        <TextBlock x:Name="TxtZoomLabel" Text="Zoom: 100%" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderZoom" Minimum="0.5" Maximum="3.0" Value="1.0" ValueChanged="SliderZoom_ValueChanged" Margin="0,0,0,12"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="↷ Rotate 90°" Click="BtnRotate_Click" Background="#334155" Foreground="White" Padding="12,6" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="🔄 Reset Position" Click="BtnReset_Click" Background="#334155" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Guide Tips -->
                        <Border Background="#0F172A" CornerRadius="4" Padding="10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Instructions:" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtHelpTips" Text="• Click &amp; drag the photo inside the canvas to position the face.&#x0a;• Use the Zoom slider or Mouse Wheel to scale.&#x0a;• The highlighted box shows the exact printable output." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Interactive Canvas -->
            <Border Grid.Column="1" Background="#020617" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                <Canvas x:Name="CanvasInteractive" Background="Transparent"
                        MouseDown="CanvasInteractive_MouseDown"
                        MouseMove="CanvasInteractive_MouseMove"
                        MouseUp="CanvasInteractive_MouseUp"
                        MouseWheel="CanvasInteractive_MouseWheel"
                        SizeChanged="CanvasInteractive_SizeChanged"
                        Cursor="Hand">
                    <!-- Target Image Transform -->
                    <Image x:Name="ImgDisplay" Stretch="None">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TransformScale"/>
                                <RotateTransform x:Name="TransformRotate"/>
                                <TranslateTransform x:Name="TransformTranslate"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Crop Target Guide Box -->
                    <Border x:Name="BorderCropFrame" BorderBrush="#38BDF8" BorderThickness="2" Background="Transparent" IsHitTestVisible="False">
                        <!-- Crosshair grid for portrait alignment -->
                        <Grid>
                            <Border BorderBrush="#38BDF8" BorderThickness="0,1,0,1" Margin="0,50,0,50" Opacity="0.3"/>
                            <Border BorderBrush="#38BDF8" BorderThickness="1,0,1,0" Margin="40,0,40,0" Opacity="0.3"/>
                        </Grid>
                    </Border>
                </Canvas>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Background="#334155" Foreground="White" FontWeight="SemiBold" Padding="18,8" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="BtnSubmit" Content="✅ Submit &amp; Generate 8-Up Sheet" Click="BtnSubmit_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="22,8" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
{
  "name": "smart-xerox-hub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "customer-web",
    "admin-dashboard",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=@smart-xerox-hub/customer-web",
    "build:customer": "npm run build --workspace=@smart-xerox-hub/customer-web",
    "build:admin": "npm run build --workspace=@smart-xerox-hub/admin-dashboard",
    "build:all": "npm run build --workspace=@smart-xerox-hub/customer-web && npm run build --workspace=@smart-xerox-hub/admin-dashboard"
  }
}
